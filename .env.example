APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
# Example .env (development + production placeholders)
# Copy/adapt to your environment. NEVER commit secrets.

APP_NAME=Portfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (dev default: sqlite)
DB_CONNECTION=sqlite
# For MySQL (MAMP / production)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=portfolio
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (development)
# By default in dev we use the log driver so mails are written to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production examples (choose and set in your hosting environment)

# Postmark (recommended for Vercel / serverless)
# MAIL_MAILER=postmark
# POSTMARK_TOKEN=your-postmark-server-token
# MAIL_FROM_ADDRESS=hello@yourdomain.com
# MAIL_FROM_NAME="Your Name"

# Mailgun (HTTP or SMTP)
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.yourdomain.com
# Replace the placeholder below with your Mailgun domain (sandbox or custom)
MAILGUN_DOMAIN=sandboxfeaed6136c8f4fe4ac5236e6da441472.mailgun.org
# MAILGUN_SECRET=your-mailgun-api-key
# MAIL_FROM_ADDRESS=hello@yourdomain.com
# MAIL_FROM_NAME="Your Name"

# Generic SMTP (Alwaysdata / classic hosts)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=smtp_user
# MAIL_PASSWORD=smtp_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=hello@yourdomain.com
# MAIL_FROM_NAME="Your Name"

# AWS SES
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_DEFAULT_REGION=eu-west-1
# MAIL_FROM_ADDRESS=hello@yourdomain.com

# Contact address used by the application
MAIL_CONTACT_ADDRESS=j.losaint@gmail.com

# Queue settings (use redis or database in production)
QUEUE_CONNECTION=database

# After changing env on the server, run:
# php artisan config:cache
# php artisan route:cache

# Notes:
# - On Vercel: prefer API drivers (Postmark, Mailgun HTTP, SendGrid) rather than SMTP.
# - On Alwaysdata: SMTP is usually allowed; configure credentials in the hosting panel.
# - Do not commit real secrets. Use your host/CI secret manager.

VITE_APP_NAME="${APP_NAME}"
